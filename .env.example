# Databricks Configuration
DATABRICKS_WORKSPACE_URL=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXX

# Unity Catalog Configuration
DATABRICKS_CATALOG=<your-catalog-name>
DATABRICKS_SCHEMA=<your-schema-name>
DATABRICKS_VOLUME=<your-volume-name>

# Logging Configuration
LOGS_PATH=logs
LOG_RETENTION_DAYS=30
DATABRICKS_LOGS_TABLE=etl_logs

# REST API Authentication (optional)
# Use format: {CREDENTIAL_KEY}_AUTH_TYPE and {CREDENTIAL_KEY}_AUTH_CREDENTIALS
# AUTH_TYPE can be: bearer, basic, api_key, or omit if no authentication
# Example for an API with bearer token:
# MYAPI_AUTH_TYPE=bearer
# MYAPI_AUTH_CREDENTIALS=your_token_here
# Example for basic auth:
# MYAPI_AUTH_TYPE=basic
# MYAPI_AUTH_CREDENTIALS=username:password
# Example for API key:
# MYAPI_AUTH_TYPE=api_key
# MYAPI_AUTH_CREDENTIALS=your_api_key_here